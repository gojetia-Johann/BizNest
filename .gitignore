# ─── Database / migrations ────────────────────────────────────────────────────
*.db
*.sqlite3
*.sqlite

# ─── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Alembic auto-generated ───────────────────────────────────────────────────
