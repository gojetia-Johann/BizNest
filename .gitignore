# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.cache/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.log

# ─── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/

# ─── Environment variables ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# ─── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/dist/
frontend/build/
*.tsbuildinfo
next-env.d.ts

# ─── Docker ───────────────────────────────────────────────────────────────────
